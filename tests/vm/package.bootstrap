#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/bin:/sbin
test "${dynblk_disposable_acceptance:-}" = 1 || exit 1
test "${dynblk_package_test:-}" = 1 || exit 1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
fail() { echo "DYNBLK PACKAGE FAIL bootstrap: $*"; while :; do sleep 3600; done; }
run() { "$@" || fail "$*"; }
test "$(uname -r)" = 6.12.107+deb13-amd64 || fail kernel
for driver in crc32c_generic ext4 iso9660 ata_piix sd_mod sr_mod; do run modprobe "$driver"; done
sleep 3
test -b /dev/sda || fail no-scratch
test ! -b /dev/sdb || fail extra-disk
test "$(cat /sys/class/block/sda/size)" = 33554432 || fail scratch-size
mkdir -p /newroot /media
run mount -t iso9660 -o ro /dev/sr0 /media
if ! blkid /dev/sda; then
    run mke2fs -t ext4 -b 4096 -F -L DYNBLK-PKG /dev/sda
    run mount -t ext4 /dev/sda /newroot
    echo 'DYNBLK PACKAGE ROOTFS EXTRACT'
    run tar -xzpf /media/payload/rootfs.tar.gz -C /newroot
    run touch /newroot/.dynblk-package-root
    run sync
else
    test "$(blkid -s LABEL -o value /dev/sda)" = DYNBLK-PKG || fail label
    run mount -t ext4 /dev/sda /newroot
    test -f /newroot/.dynblk-package-root || fail incomplete-root
fi
run umount /media
mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run /newroot/tmp
chmod 1777 /newroot/tmp
run mount --move /proc /newroot/proc
run mount --move /sys /newroot/sys
run mount --move /dev /newroot/dev
echo 'DYNBLK PACKAGE REAL ROOT BOOT'
exec switch_root /newroot /sbin/init
