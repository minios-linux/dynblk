machine dynblk {
    cpus: 4
    ram: 3Gb
    iso: { source: "${ISO}" }
    disk scratch: { size: 8Gb }
    video main: { adapter_type: "qxl" }
    loader: "/usr/share/ovmf/OVMF.fd"
}

[snapshots: "never"]
test initramfs_device {
    dynblk {
        start
        wait "DYNBLK INIT RESTART" || "DYNBLK INIT FAIL" timeout 10m
        screenshot "${EVIDENCE}/first-boot.png"
        if (check "DYNBLK INIT FAIL") { stop; abort "Native initramfs first boot failed"; }
        stop
        start
        wait "DYNBLK INIT PASS" || "DYNBLK INIT FAIL" timeout 5m
        screenshot "${EVIDENCE}/second-boot.png"
        if (check "DYNBLK INIT FAIL") { stop; abort "Native initramfs reload failed"; }
        stop
    }
}
