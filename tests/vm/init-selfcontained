#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
fail() {
    echo "DYNBLK FAIL: $*"
    dmesg > /back/dmesg-failure.txt 2>/dev/null
    sync
    while :; do sleep 3600; done
}
run() { "$@" || fail "$*"; }
grep -qw dynblk_disposable_acceptance=1 /proc/cmdline || fail safety-token
grep -qw dynblk_selfcontained=1 /proc/cmdline || fail suite-token
test "$(uname -m)" = x86_64 || fail architecture
case "$(uname -r)" in 6.12.*) ;; *) fail kernel-version ;; esac
for driver in crc32c_generic ext2 ext4 btrfs ntfs3 vfat exfat nls_cp437 nls_ascii nls_iso8859-1 nls_utf8 loop ata_piix sd_mod sr_mod virtio_pci virtio_blk; do
    run modprobe "$driver"
done
test -x /sbin/modprobe || fail missing-kernel-autoload-helper
sleep 3
# The sole writable disk is the blank 8 GiB disk created by selfcontained.testo.
test -b /dev/sda || fail missing-disposable-disk
test ! -b /dev/sdb || fail unexpected-extra-disk
test "$(cat /sys/class/block/sda/size)" = 16777216 || fail disk-size
if ! /usr/sbin/blkid /dev/sda; then
    run mke2fs -t ext4 -F -L DYNBLK-SELF /dev/sda
fi
test "$(/usr/sbin/blkid -s LABEL -o value /dev/sda)" = DYNBLK-SELF || fail disk-label
run mount -t ext4 /dev/sda /back
touch /back/guest.log
python3.13 -u /entrypoint.py >> /back/guest.log 2>&1 &
worker=$!
tail -f /back/guest.log | tee /dev/ttyS0 &
wait "$worker" || fail selfcontained-suite
while :; do sleep 3600; done
